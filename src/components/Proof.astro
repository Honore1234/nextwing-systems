---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).proof;
---

<section class="proof">
  <div>
    <p class="tag">{t.tag}</p>
    <h2>{t.title}</h2>
  </div>

  <div class="proof-grid">
    {t.items.map((i) => (
      <div>
        <strong>{i.num}</strong>
        <p>{i.text}</p>
      </div>
    ))}
  </div>
</section>
