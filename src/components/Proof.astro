---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).proof;
---

<section class="panel proof">
  <div class="panel-body">
    <div class="head">
      <p class="tag">{t.tag}</p>
      <h2 class="display">{t.title}</h2>
    </div>
    <ul class="checks">
      {t.items.map((i) => <li>{i.text}</li>)}
    </ul>
  </div>
</section>
