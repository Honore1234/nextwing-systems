---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).system;
---

<section id="system" class="system">
  <div class="section-head inverted">
    <p class="tag">{t.tag}</p>
    <h2>{t.title}</h2>
    <p>{t.intro}</p>
  </div>

  <div class="system-map">
    {t.blocks.map((b) => (
      <article>
        <span>{b.num}</span>
        <h3>{b.title}</h3>
        <p>{b.text}</p>
      </article>
    ))}
  </div>

  <div class="testbed-banner">
    <div>
      <p class="tag">{t.testbed.tag}</p>
      <h3>{t.testbed.title}</h3>
    </div>
    <p>{t.testbed.text}</p>
  </div>
</section>
