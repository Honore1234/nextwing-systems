---
import { useTranslations } from '../i18n';
import Media from './Media.astro';
const t = useTranslations(Astro.currentLocale).system;
---

<section id="system" class="panel system">
  <div class="panel-body">
    <div class="head">
      <p class="tag">{t.tag}</p>
      <h2>{t.title}</h2>
      <p class="lead">{t.intro}</p>
    </div>

    <div class="columns">
      {t.blocks.map((b) => (
        <article>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="panel testbed">
  <Media name="testbed" glow="80% 70%" />
  <div class="panel-body">
    <p class="tag">{t.testbed.tag}</p>
    <h2>{t.testbed.title}</h2>
    <p class="lead">{t.testbed.text}</p>
  </div>
</section>
