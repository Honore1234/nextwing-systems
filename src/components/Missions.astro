---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).missions;
---

<section id="missions" class="missions">
  <div class="section-head">
    <p class="tag">{t.tag}</p>
    <h2>{t.title}</h2>
  </div>

  <div class="mission-stack">
    {t.items.map((m) => (
      <article class="mission">
        <div class="mission-number">{m.num}</div>
        <div>
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </div>
        <span>{m.badge}</span>
      </article>
    ))}
  </div>
</section>
