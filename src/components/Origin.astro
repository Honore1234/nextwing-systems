---
import { useTranslations } from '../i18n';
import Media from './Media.astro';
const t = useTranslations(Astro.currentLocale).origin;
---

<section id="origin" class="panel origin">
  <Media name="origin" glow="20% 60%" />

  <div class="panel-body split">
    <div>
      <p class="tag">{t.tag}</p>
      <h2>{t.title}</h2>
      <p class="lead">{t.intro}</p>
    </div>

    <div>
      <h3 class="spec-title">{t.dataTitle}</h3>
      <dl class="spec">
        {t.data.map((d) => (
          <div>
            <dt>{d.label.replace(/:$/, '')}</dt>
            <dd>{d.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
