---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).origin;
---

<section id="origin" class="origin">
  <div class="section-head">
    <p class="tag">{t.tag}</p>
    <h2>{t.title}</h2>
    <p>{t.intro}</p>
  </div>

  <div class="flight-card">
    <div class="aircraft-sketch">
      <div class="body"></div>
      <div class="main-wing"></div>
      <div class="tail-wing"></div>
      <div class="nose"></div>
      <div class="prop"></div>
    </div>

    <div class="flight-data">
      <h3>{t.dataTitle}</h3>
      <ul>
        {t.data.map((d) => <li><strong>{d.label}</strong> {d.text}</li>)}
      </ul>
    </div>
  </div>
</section>
