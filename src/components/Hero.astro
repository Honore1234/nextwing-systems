---
import { useTranslations } from '../i18n';
import Media from './Media.astro';
const t = useTranslations(Astro.currentLocale).hero;
---

<section class="panel hero">
  <Media name="hero" glow="72% 38%" />

  <div class="panel-body hero-copy">
    <p class="tag">{t.tag}</p>
    <h1>{t.titleLines.map((line) => <span>{line}</span>)}</h1>
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <a class="btn" href="#system">{t.primaryCta}</a>
      <a class="btn ghost" href="#origin">{t.secondaryCta}</a>
    </div>
  </div>

  <dl class="hud">
    {t.hud.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</section>
