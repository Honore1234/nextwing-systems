---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).contact;
---

<section id="contact" class="contact">
  <p class="tag">{t.tag}</p>
  <h2>{t.title}</h2>
  <p>{t.text}</p>

  <div class="contact-card">
    <span>{t.cardLabel}</span>
    <a href={`mailto:${t.email}`}>{t.email}</a>
  </div>
</section>
