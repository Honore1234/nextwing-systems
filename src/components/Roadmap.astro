---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).roadmap;
---

<section id="roadmap" class="roadmap">
  <div class="section-head">
    <p class="tag">{t.tag}</p>
    <h2>{t.title}</h2>
  </div>

  <div class="timeline">
    <div class="line"></div>

    {t.steps.map((s) => (
      <article>
        <span>{s.num}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </article>
    ))}
  </div>
</section>
