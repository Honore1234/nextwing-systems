---
import { getLocale, localePath, locales, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<header class="nav">
  <a href="#home" class="brand">
    <span class="mark">NX</span>
    <span>
      <strong>{t.nav.brandName}</strong>
      <small>{t.nav.brandBy}</small>
    </span>
  </a>

  <nav>
    {t.nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
    <span class="lang-switch" role="group" aria-label={t.nav.switchLabel}>
      {locales.map((l) => (
        <a
          href={localePath(l)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'page' : undefined}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </span>
  </nav>
</header>
