---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).manifesto;
---

<section class="panel manifesto">
  <div class="panel-body center">
    <p class="tag">{t.kicker}</p>
    <h2 class="display">{t.title}</h2>
    <ul class="values">
      {t.values.map((v) => <li>{v}</li>)}
    </ul>
  </div>
</section>
