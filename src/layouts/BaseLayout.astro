---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getLocale, localePath, locales, defaultLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

interface Props {
  title?: string;
  description?: string;
}

const { title = t.meta.title, description = t.meta.description } = Astro.props;

// Absolute URLs (canonical, og:url, hreflang) need `site` in astro.config.mjs;
// until then hreflang falls back to root-relative paths.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site ? abs(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Language alternates -->
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(defaultLocale))} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NextWing Systems" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={useTranslations(l).meta.ogLocale} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <!-- TODO: add og:image (1200x630) once a share image exists in /public -->

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="noise"></div>
    <slot />
  </body>
</html>
