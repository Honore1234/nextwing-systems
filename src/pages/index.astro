---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Origin from '../components/Origin.astro';
import System from '../components/System.astro';
import Missions from '../components/Missions.astro';
import Proof from '../components/Proof.astro';
import Roadmap from '../components/Roadmap.astro';
import Ethics from '../components/Ethics.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Nav />

  <main id="home">
    <Hero />
    <Manifesto />
    <Origin />
    <System />
    <Missions />
    <Proof />
    <Roadmap />
    <Ethics />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
